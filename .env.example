MONGODB_URI=mongodb+srv://username:password@cluster.example.mongodb.net/elliotsglobal
SESSION_SECRET=replace-with-at-least-32-random-characters
APP_URL=http://localhost:3000
PLATFORM_COMMISSION_PERCENT=15

# Resend password-reset emails. Use a sender address on a verified Resend domain.
RESEND_API_KEY=re_replace_me
EMAIL_FROM="Elliot's Global <no-reply@example.com>"

# Stripe test mode. Never expose secret keys to browser code.
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me

# Required only for the one-time admin provisioning command.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-long-unique-password
CATALOG_SELLER_EMAIL=approved-seller@example.com
